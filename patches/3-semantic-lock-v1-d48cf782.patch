new file mode 100644
index 0000000..9142959
--- /dev/null
+++ b/docs/typed-c-slice-b-semantic-lock.md
@@ -0,0 +1,21 @@
+# Slice B measured lock semantic verifier
+
+This change adds only a pure in-memory `verify_lock.py` and tests. It does not wire production `verify.py`, create an initramfs, launch QEMU or accredit isolation. The existing `SBL1` parser verifies framing/canonical JSON, not an authoritative lock.
+
+## Input provenance and state
+
+Fixture `tests/typed_c_measured_lock.sbl1` was built from the signed Ubuntu Noble snapshot `20260927T000000Z` audit records, after byte-verifying 128 `.deb` payloads (146,235,932 compressed bytes) against `Packages`, streaming and filtering 6,782 entries, and rehashing 4,652 retained regular files. It contains exactly 128 package records, 5,283 non-directory rows, 698 unique directories, eight excluded setuid/setgid paths, 12 Packages and 12 Sources index digests, the three signed InRelease digests, and actual kernel/QEMU/BusyBox hashes. SHA-256 of complete SBL1 fixture: `52dd50f15f0c5638a02ef5b750ad756a07ed7925281dfb36606c2af474b978b8`; frame length 1,218,485 bytes, under the unchanged 4 MiB cap. The audit JSON records are evidence, not accepted as runtime lock bytes.
+
+The fixture's state is `measured_payloads_only`, builder `unverified`, image `not_built`. The semantic verifier returns only `validated_evidence_only`, `launch_eligible=False` for matching context. No `pinned_image` state can pass the current verifier, because the builder closure, initramfs, supervisor and runtime-open proof do not exist. It refuses `pin_incomplete` even if a caller fills plausible hashes. This is a conservative gate, not a feature toggle.
+
+## Closed schema and precedence
+
+Exactly 12 sorted top-level keys: `architecture`, `builder`, `directories`, `exclusions`, `files`, `image`, `packages`, `provenance`, `review_by_utc`, `schema`, `snapshot_id`, `state`. All nested keys closed in `verify_lock.py`; types checked exactly (`bool` is never an integer), normalized relative paths, sorted unique records, no symlink-parent paths, and caps of 256 packages, 10,000 total file+directory paths, 1 GiB expanded file bytes, 4 MiB SBL1 frame. Directories include all 698 unique paths and modes; repeat directory entries in packages must agree. No sidecar, no Merkle, no silent omission.
+
+Error precedence: SBL1 magic/length/truncated/trailing/digest, then JSON duplicate/noncanonical, then all schema fields, then types/caps/order, then context binding, then exclusions/setuid, then state/freshness. `verify_lock.py` handles the semantic stages only; frame/JSON precedence belongs to `lock_wire.py`. Context is provided from independently authenticated/rehashed audit data by a later caller, not from the lock itself. Tests inject matching context to prove the pure verifier and mutate fields to prove refusal; they do not establish the provenance of that context on their own.
+
+The eight exclusions are exact `(package,path)` pairs, with reason `setuid account-management helpers; guest runtime has no auth flow or account management`. Raw package setuid scan must show exactly those eight and final image must contain none; any ninth is a refusal. The measured fixture records excluded account/PAM helpers but has not run a guest to prove no auth flow. Missing `Valid-Until` is recorded as `no_expiry_field; freshness_enforced_by_review_by`, an explicit parent technical freshness decision. A future pinned image would require an acquisition UTC timestamp, `review_by <=30 days`, and early review for CVE/EOL/revoked signature/runner change, but this verifier denies all pinned launches regardless. Kernel/QEMU/BusyBox bytes coincide with hosted KVM preflight #4 (https://github.com/FiveTechSoft/symbols/actions/runs/36406181849/job/108875367605) as cross-check, not substitute for signed snapshot chain.
+
+## Deferred
+
+The current caller does not yet remeasure closed builder loader/interpreter/extractor/readelf/Python dependency bytes. The 14 extra Noble bootstrap `.deb` packages are metadata candidates only, +8,116,208 B; no new payload was downloaded for this code change. A later independent gate must verify and scan those packages, pin builder tools, repeat extraction in a clean builder and byte-compare; then a separate double image build. QEMU dlopen/firmware and GCC specs/sysroot/runtime-open closure, host-enforced limits, guest UID/channel separation and adversarial isolation tests remain later gates. `verify_lock.py` accepts no external content as authorization to start any of them.
diff --git a/tests/test_typed_c_verify_lock.py b/tests/test_typed_c_verify_lock.py
new file mode 100644
index 0000000..81a18d4
--- /dev/null
+++ b/tests/test_typed_c_verify_lock.py
@@ -0,0 +1,83 @@
+"""Semantic measured-only lock binding tests. No artifacts executed."""
+import copy
+import hashlib
+import json
+from pathlib import Path
+import sys
+import unittest
+from unittest import mock
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT/'tools'/'typed_c_contract'))
+from lock_wire import decode_lock_wire, encode_lock_wire
+from verify_lock import LockRefusal, EXCLUSIONS, verify_lock
+FIXTURE = Path(__file__).with_name('typed_c_measured_lock.sbl1')
+SHA256 = '52dd50f15f0c5638a02ef5b750ad756a07ed7925281dfb36606c2af474b978b8'
+NOW = '2026-09-28T12:55:00Z'
+
+
+def context(lock):
+    expected = {k:copy.deepcopy(lock[k]) for k in ('packages','files','directories','exclusions','provenance','image','snapshot_id')}
+    expected['raw_setuid_paths'] = sorted(path for _,path in EXCLUSIONS)
+    return expected
+
+
+class SemanticTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        raw=FIXTURE.read_bytes()
+        assert hashlib.sha256(raw).hexdigest()==SHA256
+        cls.original=decode_lock_wire(raw)
+        assert encode_lock_wire(cls.original)==raw
+        cls.trusted=context(cls.original)
+
+    def refuse(self, mutation, code, trusted=None, **kwargs):
+        candidate=copy.deepcopy(self.original)
+        mutation(candidate)
+        with self.assertRaises(LockRefusal) as error:
+            verify_lock(candidate,trusted=copy.deepcopy(self.trusted if trusted is None else trusted),now_utc=NOW,**kwargs)
+        self.assertEqual(error.exception.code,code)
+
+    def test_full_measured_fixture_evidence_only(self):
+        lock=self.original
+        self.assertEqual((len(lock),len(lock['packages']),len(lock['files']),len(lock['directories']),len(lock['exclusions'])),(12,128,5283,698,8))
+        self.assertEqual(sum(x['size'] for x in lock['packages']),146235932)
+        self.assertEqual(sum(x['size'] or 0 for x in lock['files']),383592580)
+        self.assertEqual(lock['image']['kernel_sha256'],'cd5fcfd260b91782637b7b4e221a48e656358f6eef549602540e62380b6f2f2c')
+        self.assertEqual(lock['image']['qemu_sha256'],'8a35ccba41582fc6c38b9df85fc9e35fa1d42f414d2d7d8090ee9b2f5e7c0854')
+        self.assertEqual(lock['image']['busybox_sha256'],'dbac288c29ba568459550a2da9e7ae0ded6b1fc728ee9fad3044c44e62d6ac14')
+        with mock.patch('subprocess.Popen',side_effect=AssertionError('process launch')):
+            self.assertEqual(verify_lock(lock,trusted=self.trusted,now_utc=NOW),{'status':'validated_evidence_only','launch_eligible':False})
+
+    def test_fields_type_order_caps(self):
+        self.refuse(lambda x:x.__setitem__('unknown',1),'fields')
+        self.refuse(lambda x:x['builder'].__setitem__('extra',1),'fields')
+        self.refuse(lambda x:x['files'][0].__setitem__('extra',1),'fields')
+        self.refuse(lambda x:x['directories'][0].pop('mode'),'fields')
+        self.refuse(lambda x:x['provenance']['inrelease_sha256'].__setitem__('extra','0'*64),'fields')
+        self.refuse(lambda x:x.__setitem__('architecture','arm64'),'architecture')
+        self.refuse(lambda x:x.__setitem__('snapshot_id','20260932T000000Z'),'snapshot')
+        self.refuse(lambda x:x['packages'][0].__setitem__('size',True),'type')
+        self.refuse(lambda x:x['files'][0].__setitem__('mode',0o4755),'type')
+        self.refuse(lambda x:x['files'].reverse(),'order')
+        self.refuse(lambda x:x['packages'].append(copy.deepcopy(x['packages'][-1])),'order')
+        self.refuse(lambda x:x['files'][0].__setitem__('size',2**30+1),'type')
+        self.refuse(lambda x:x['files'][0].__setitem__('path','../escape'),'path')
+
+    def test_context_exclusions_setuid_state(self):
+        self.refuse(lambda x:next(row for row in x['files'] if row['type']=='file').__setitem__('sha256','0'*64),'context')
+        self.refuse(lambda x:x['packages'][0].__setitem__('size',x['packages'][0]['size']+1),'context')
+        self.refuse(lambda x:x['directories'][0].__setitem__('mode',0o700),'context')
+        self.refuse(lambda x:x['exclusions'][0].__setitem__('reason','wrong'),'exclusions')
+        t=context(self.original);t['raw_setuid_paths'].append('usr/bin/new-setuid')
+        self.refuse(lambda x:None,'setuid',trusted=t)
+        self.refuse(lambda x:x['builder'].__setitem__('state','pretend-pinned'),'state')
+        self.refuse(lambda x:x.__setitem__('state','pinned_image'),'pin_incomplete')
+        self.refuse(lambda x:x['files'][0].__setitem__('path','usr/bin/passwd'),'order')
+
+    def test_precedence(self):
+        # Field/schema check wins over context, then type/order, then context, then exclusions.
+        self.refuse(lambda x:(x.__setitem__('unknown',1),next(row for row in x['files'] if row['type']=='file').__setitem__('sha256','0'*64)),'fields')
+        self.refuse(lambda x:(x['packages'][0].__setitem__('size',True),next(row for row in x['files'] if row['type']=='file').__setitem__('sha256','0'*64)),'type')
+        self.refuse(lambda x:(next(row for row in x['files'] if row['type']=='file').__setitem__('sha256','0'*64),x['exclusions'][0].__setitem__('reason','wrong')),'context')
+
+if __name__ == '__main__':unittest.main()
